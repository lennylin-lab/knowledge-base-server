# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment & secrets
.env
.env.*
!.env.example

# MCP server config (may hold real API keys in `env`); copy from mcp.json.example
mcp.json

# Production mount point for the app's mcp.json (docker-compose.prod.yml);
# contents are operator-local, same secret rules as mcp.json
mcp-config/

# Claude Code local settings (machine-specific) and transient temp files
.claude/settings.local.json
.claude/*.tmp.*

# Editors & OS
.idea/
.vscode/
.DS_Store
pyrightconfig.json

# Pre-fetched Elasticsearch plugin (fetch before `docker compose build`;
# see docker/elasticsearch/Dockerfile)
docker/elasticsearch/*.zip
