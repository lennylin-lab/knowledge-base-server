# Copy to .env and adjust. Every variable is prefixed KB_ (see src/app/core/config.py);
# defaults shown here match docker-compose.yml.

# --- datastore ---
KB_DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5432/kb
KB_ELASTICSEARCH_URL=http://localhost:9200

# --- http / CORS ---
# Allowed CORS origins for browser clients; empty disables CORS entirely
# (production default). Local development: ["*"] (any origin) or explicit
# origins, e.g. ["http://localhost:5173"].
KB_CORS_ORIGINS=[]

# --- LLM providers (OpenAI-compatible endpoints; embedding and chat are
# --- independently configurable and may point at different providers) ---
KB_EMBEDDING_BASE_URL=https://api.openai.com/v1
KB_EMBEDDING_API_KEY=sk-change-me
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_DIM=1536
KB_CHAT_BASE_URL=https://api.openai.com/v1
KB_CHAT_API_KEY=sk-change-me
KB_CHAT_MODEL=gpt-4o-mini
# Multi-turn history: total TOKENS of complete turns sent back to the agent
# as conversation history (oldest turns drop out first; counted with the
# chat model's tiktoken encoding, deterministic heuristic fallback offline).
# Breaking rename: replaces the retired KB_CHAT_HISTORY_CHAR_BUDGET.
KB_CHAT_HISTORY_TOKEN_BUDGET=2000
# Long-document guardrail: one turn may use at most this fraction of the
# history token budget; an oversized turn (e.g. a long pasted document) is
# admitted truncated-with-marker instead of evicting the rest of history.
# >= 1.0 disables the guardrail (turns stand whole).
KB_CHAT_HISTORY_MAX_TURN_FRACTION=0.5
# History-aware query rewriting for follow-ups: before each non-first turn,
# a rewrite call turns anaphoric questions into a self-contained retrieval
# query using recent history. false disables the step entirely.
KB_CHAT_QUERY_REWRITE_ENABLED=true
# Recent complete turns (user + assistant) fed to the rewriter; <= 0 uses
# the full history window.
KB_CHAT_REWRITE_HISTORY_TURNS=3
# Rolling summary of evicted history: turns that fall outside the token
# window are folded incrementally into a stored per-session summary that
# leads the next turn's history as labeled context (older context degrades
# gradually instead of vanishing). One extra model call after an answer,
# only when new turns evicted. false disables the step entirely.
KB_CHAT_ROLLING_SUMMARY_ENABLED=true
# Bound on the rolling summary in tokens; also the budget slice reserved
# for injecting it so turn growth can never evict the summary itself.
KB_CHAT_SUMMARY_MAX_TOKENS=400
# Carry the previous run's sources into follow-up turns: each run's sources
# are persisted on the assistant message and re-emitted (citable) at the
# start of the next turn's run. false disables it entirely (byte-identical
# to the pre-carry behavior; stored sources are simply not carried).
KB_CHAT_SOURCES_CARRY_ENABLED=true

# --- MCP extension ---
# Path to a Claude-Desktop-style mcp.json (copy mcp.json.example); an absent
# file disables MCP entirely. Restart the server to apply config changes.
# KB_MCP_CONFIG_PATH=mcp.json

# --- indexing queue (ARQ + Redis) ---
# Empty (default) = indexing runs as in-process background tasks after each
# write; local development stays zero-dependency. Set to the compose Redis
# (redis://localhost:6379) and run `python -m app.cli worker` to route
# indexing through the ARQ task queue with automatic retries instead.
KB_REDIS_URL=
# Queue-level retry policy for indexing jobs: attempts per job, and the
# delay before the first retry (doubling each attempt: 5s, 10s, 20s ...).
KB_INDEX_JOB_MAX_TRIES=3
KB_INDEX_JOB_RETRY_MIN_DELAY_S=5

# --- search relevance gates (hybrid retriever quality floors) ---
# Weak matches are dropped instead of padding results — empty beats noise on
# small corpora. Disable sentinels: 0.0 (BM25 floor / relative floor), 2.0
# (vector distance ceiling and rescue trigger; cosine distance ranges 0..2).
# Absolute BM25 score floor — RETIRED (0.0): BM25 score scales are
# query-dependent, so a floor calibrated for one query is meaningless for
# another. Kept only as a measured operator escape hatch.
KB_SEARCH_BM25_MIN_SCORE=0.0
# BM25 term coverage: ES minimum_should_match on the prose field — how much
# of the query a document must match. The scale-free noise gate (an
# unrelated query matches ~none of its terms). Empty string omits the key
# entirely (gate disabled).
KB_SEARCH_BM25_MIN_COVERAGE=70%
KB_SEARCH_VECTOR_MAX_DISTANCE=0.45
# Vector head rescue (short-query granularity shift): only when the ceiling
# above empties the vector leg, rows within min(leg_min + margin, cap) join
# fusion; the cap is the hard noise floor. Either value <= 0 disables rescue.
KB_SEARCH_VECTOR_RESCUE_MARGIN=0.15
KB_SEARCH_VECTOR_RESCUE_MAX_DISTANCE=0.85
# On-domain rescue trigger: rescue fires only when the emptied leg's own
# minimum distance is at or below this — an off-domain leg stays empty
# instead of rescuing its noise band. 2.0 (or greater) disables the trigger
# (rescue fires whenever the ceiling empties the leg).
KB_SEARCH_VECTOR_RESCUE_TRIGGER_MAX_DISTANCE=0.62
KB_SEARCH_RRF_MIN_RELATIVE=0.35
# Query length cap: retrieve() truncates over-long queries to this many
# characters before any leg runs (<= 0 disables).
KB_SEARCH_MAX_QUERY_LENGTH=256

# --- observability ---
KB_LOG_LEVEL=INFO
KB_LOG_FORMAT=console
