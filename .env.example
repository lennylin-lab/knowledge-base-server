# Copy to .env and adjust. Every variable is prefixed KB_ (see src/app/core/config.py);
# defaults shown here match docker-compose.yml.

# --- datastore ---
KB_DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5432/kb
KB_ELASTICSEARCH_URL=http://localhost:9200

# --- http / CORS ---
# Allowed CORS origins for browser clients; empty disables CORS entirely
# (production default). Local development: ["*"] (any origin) or explicit
# origins, e.g. ["http://localhost:5173"].
KB_CORS_ORIGINS=[]

# --- LLM providers (OpenAI-compatible endpoints; embedding and chat are
# --- independently configurable and may point at different providers) ---
KB_EMBEDDING_BASE_URL=https://api.openai.com/v1
KB_EMBEDDING_API_KEY=sk-change-me
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_DIM=1536
KB_CHAT_BASE_URL=https://api.openai.com/v1
KB_CHAT_API_KEY=sk-change-me
KB_CHAT_MODEL=gpt-4o-mini
# Multi-turn history: total characters of complete turns sent back to the
# agent as conversation history (oldest turns drop out first).
KB_CHAT_HISTORY_CHAR_BUDGET=8000

# --- MCP extension ---
# Path to a Claude-Desktop-style mcp.json (copy mcp.json.example); an absent
# file disables MCP entirely. Restart the server to apply config changes.
# KB_MCP_CONFIG_PATH=mcp.json

# --- indexing queue (ARQ + Redis) ---
# Empty (default) = indexing runs as in-process background tasks after each
# write; local development stays zero-dependency. Set to the compose Redis
# (redis://localhost:6379) and run `python -m app.cli worker` to route
# indexing through the ARQ task queue with automatic retries instead.
KB_REDIS_URL=
# Queue-level retry policy for indexing jobs: attempts per job, and the
# delay before the first retry (doubling each attempt: 5s, 10s, 20s ...).
KB_INDEX_JOB_MAX_TRIES=3
KB_INDEX_JOB_RETRY_MIN_DELAY_S=5

# --- search relevance gates (hybrid retriever quality floors) ---
# Weak matches are dropped instead of padding results — empty beats noise on
# small corpora. Disable sentinels: 0.0 (BM25 floor / relative floor), 2.0
# (vector distance ceiling; cosine distance ranges 0..2).
KB_SEARCH_BM25_MIN_SCORE=1.0
KB_SEARCH_VECTOR_MAX_DISTANCE=0.45
KB_SEARCH_RRF_MIN_RELATIVE=0.35

# --- observability ---
KB_LOG_LEVEL=INFO
KB_LOG_FORMAT=console
